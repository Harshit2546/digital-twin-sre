# Digital Twin SRE Agent Configuration

# LLM API Keys (Optional for deterministic --mock evaluation)
GEMINI_API_KEY="your-google-gemini-api-key"

# Model Selection
MODEL_NAME="gemini-2.5-pro"

# Paths (Defaults to bundled ./benchmark)
# BENCHMARK_DIR="./benchmark"
TWIN_BASE_DIR="/tmp/digital_twins"

# Ports for Twin Execution (0 enables dynamic ephemeral port allocation by OS kernel)
TWIN_API_PORT=0
TWIN_PAYMENTS_PORT=0
TWIN_DB_PORT=0

# Agent Parameters
MAX_AGENT_ITERATIONS=10
