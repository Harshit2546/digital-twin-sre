# ==============================================================================
# DIGITAL TWIN SRE AGENT CONFIGURATION
# ==============================================================================

# Target LLM Model (Supported by LiteLLM)
# Examples:
#   - deepseek/deepseek-chat
#   - anthropic/claude-3-5-sonnet-20241022
#   - gpt-4o
#   - gemini/gemini-2.5-flash
#   - ollama/qwen2.5-coder:7b
LLM_MODEL=deepseek/deepseek-chat

# API Keys (Set whichever provider you are using)
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# GitHub Token (Optional: For automated Pull Request creation)
GITHUB_TOKEN=""

# Runtime Execution Settings
TWIN_BASE_DIR="/tmp/digital_twins"
MAX_AGENT_ITERATIONS=8
