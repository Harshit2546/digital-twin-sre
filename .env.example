# Digital Twin SRE Agent Configuration

# LLM API Keys
GEMINI_API_KEY="your-google-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"

# Model Selection
MODEL_NAME="gemini-2.5-pro"

# Paths
BENCHMARK_DIR="../benchmark"
TWIN_BASE_DIR="/tmp/digital_twins"

# Ports for Twin Execution
TWIN_API_PORT=8000
TWIN_PAYMENTS_PORT=8001
TWIN_DB_PORT=5432

# Agent Parameters
MAX_AGENT_ITERATIONS=10
